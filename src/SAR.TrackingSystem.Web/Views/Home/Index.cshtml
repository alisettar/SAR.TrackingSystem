@model SAR.TrackingSystem.Web.Models.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="row">
    <div class="col-md-12">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="mb-0">
                <i class="bi bi-speedometer2 text-primary"></i>
                Gösterge Paneli
            </h1>
            <div class="text-end">
                <small class="text-muted d-block">
                    Son Güncelleme: <span id="lastUpdate">@DateTime.Now.ToString("dd.MM.yyyy HH:mm:ss")</span>
                </small>
                <span class="badge bg-success">
                    <i class="bi bi-arrow-clockwise"></i> Otomatik
                </span>
            </div>
        </div>
    </div>
</div>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">
        <i class="bi bi-exclamation-triangle"></i>
        @ViewBag.Error
    </div>
}

<div id="dashboard-content">
    @await Html.PartialAsync("_DashboardContent", Model)
</div>

@section Scripts {
    <script>
        let refreshInterval;
        
        let currentChart = null;
        let chartData = null;
        let currentCityChart = null;
        let cityChartData = null;
        
        function refreshDashboard() {
            // Güçlü cache-busting 
            const timestamp = new Date().getTime();
            const random = Math.random().toString(36).substring(7);
            fetch(`/Home/GetDashboardData?_=${timestamp}&r=${random}`, {
                method: 'GET',
                cache: 'no-cache',
                headers: {
                    'Cache-Control': 'no-cache, no-store, must-revalidate',
                    'Pragma': 'no-cache',
                    'Expires': '0'
                }
            })
                .then(response => response.text())
                .then(html => {
                    // Clear chart variables
                    if (currentChart) {
                        currentChart.destroy();
                        currentChart = null;
                    }
                    if (currentCityChart) {
                        currentCityChart.destroy();
                        currentCityChart = null;
                    }
                    chartData = null;
                    cityChartData = null;
                    
                    document.getElementById('dashboard-content').innerHTML = html;
                    // Update last update time
                    const now = new Date();
                    const timeStr = now.toLocaleDateString('tr-TR') + ' ' + now.toLocaleTimeString('tr-TR');
                    document.getElementById('lastUpdate').textContent = timeStr;
                    console.log('Dashboard updated:', new Date().toLocaleTimeString());
                    initializeCharts();
                })
                .catch(error => {
                    console.error('Dashboard refresh failed:', error);
                });
        }
        
        function initializeCharts() {
            initializeSectorChart();
            initializeCityChart();
        }
        
        function initializeSectorChart() {
            const chartCanvas = document.getElementById('sectorChart');
            const rawData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SectorDistribution.Data));
            
            if (chartCanvas && rawData && rawData.length > 0) {
                chartData = {
                    labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SectorDistribution.Labels)),
                    data: rawData,
                    colors: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SectorDistribution.BackgroundColors))
                };
                createChart('sector', 'pie');
            }
        }
        
        function initializeCityChart() {
            const chartCanvas = document.getElementById('cityChart');
            const rawData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CityDistribution.Data));
            
            if (chartCanvas && rawData && rawData.length > 0) {
                cityChartData = {
                    labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CityDistribution.Labels)),
                    data: rawData,
                    colors: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CityDistribution.BackgroundColors))
                };
                createChart('city', 'pie');
            }
        }
        
        function createChart(chartType, type) {
            const isCity = chartType === 'city';
            const chartCanvas = document.getElementById(isCity ? 'cityChart' : 'sectorChart');
            const data = isCity ? cityChartData : chartData;
            let chart = isCity ? currentCityChart : currentChart;
            
            if (!chartCanvas || !data) return;
            
            if (chart) {
                chart.destroy();
            }
            
            const ctx = chartCanvas.getContext('2d');
            let labels = data.labels;
            let dataValues = data.data;  // Renamed to avoid conflict
            let colors = data.colors;
            
            if (type === 'bar') {
                const combined = labels.map((label, i) => ({ label, data: dataValues[i], color: colors[i] }));
                combined.sort((a, b) => b.data - a.data);
                
                labels = combined.map(item => item.label);
                dataValues = combined.map(item => item.data);
                colors = combined.map(item => item.color);
            }
            
            const newChart = new Chart(ctx, {
                type: type,
                data: {
                    labels: labels,
                    datasets: [{
                        data: dataValues,
                        backgroundColor: colors,
                        borderColor: colors.map(color => color + '80'),
                        borderWidth: type === 'bar' ? 1 : 0
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { 
                            position: type === 'pie' ? 'bottom' : 'top',
                            display: type === 'pie'
                        }
                    },
                    scales: type === 'bar' ? {
                        y: {
                            beginAtZero: true,
                            ticks: { stepSize: 1 }
                        }
                    } : {}
                }
            });
            
            if (isCity) {
                currentCityChart = newChart;
            } else {
                currentChart = newChart;
            }
        }
        
        function switchChart(chartType, type) {
            const isCity = chartType === 'city';
            
            let pieBtn, barBtn;
            
            if (isCity) {
                pieBtn = document.getElementById('cityPieBtn');
                barBtn = document.getElementById('cityBarBtn');
            } else {
                pieBtn = document.getElementById('pieBtn');
                barBtn = document.getElementById('barBtn');
            }
            
            // Remove active class from both buttons
            if (pieBtn) pieBtn.classList.remove('active');
            if (barBtn) barBtn.classList.remove('active');
            
            // Add active class to the clicked button
            if (type === 'pie' && pieBtn) {
                pieBtn.classList.add('active');
            } else if (type === 'bar' && barBtn) {
                barBtn.classList.add('active');
            }
            
            createChart(chartType, type);
        }
        
        // Initialize chart on page load
        document.addEventListener('DOMContentLoaded', initializeCharts);
        
        // Start auto-refresh every 30 seconds
        refreshInterval = setInterval(refreshDashboard, 30000);
        
        // Cleanup on page unload
        window.addEventListener('beforeunload', () => {
            if (refreshInterval) {
                clearInterval(refreshInterval);
            }
        });
    </script>
}
