@model SAR.TrackingSystem.Web.Models.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="row">
    <div class="col-md-12">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="mb-0">
                <i class="bi bi-speedometer2 text-primary"></i>
                Gösterge Paneli
            </h1>
            <div class="text-end">
                <small class="text-muted d-block">
                    Son Güncelleme: <span id="lastUpdate">@DateTime.Now.ToString("dd.MM.yyyy HH:mm:ss")</span>
                </small>
                <span class="badge bg-success">
                    <i class="bi bi-arrow-clockwise"></i> Otomatik
                </span>
            </div>
        </div>
    </div>
</div>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">
        <i class="bi bi-exclamation-triangle"></i>
        @ViewBag.Error
    </div>
}

<div id="dashboard-content">
    @await Html.PartialAsync("_DashboardContent", Model)
</div>

@section Scripts {
    <!-- Leaflet CSS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <!-- Leaflet JS -->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    
    <script>
        let refreshInterval;
        
        let currentChart = null;
        let chartData = null;
        let currentCityChart = null;
        let cityChartData = null;
        
        function refreshDashboard() {
            // Güçlü cache-busting 
            const timestamp = new Date().getTime();
            const random = Math.random().toString(36).substring(7);
            fetch(`/Home/GetDashboardData?_=${timestamp}&r=${random}`, {
                method: 'GET',
                cache: 'no-cache',
                headers: {
                    'Cache-Control': 'no-cache, no-store, must-revalidate',
                    'Pragma': 'no-cache',
                    'Expires': '0'
                }
            })
                .then(response => response.text())
                .then(html => {
                    // Clear chart variables
                    if (currentChart) {
                        currentChart.destroy();
                        currentChart = null;
                    }
                    if (currentCityChart) {
                        currentCityChart.destroy();
                        currentCityChart = null;
                    }
                    chartData = null;
                    cityChartData = null;
                    
                    document.getElementById('dashboard-content').innerHTML = html;
                    // Update last update time
                    const now = new Date();
                    const timeStr = now.toLocaleDateString('tr-TR') + ' ' + now.toLocaleTimeString('tr-TR');
                    document.getElementById('lastUpdate').textContent = timeStr;
                    console.log('Dashboard updated:', new Date().toLocaleTimeString());
                    initializeCharts();
                })
                .catch(error => {
                    console.error('Dashboard refresh failed:', error);
                });
        }
        
        let sectorMap = null;
        
        function initializeCharts() {
            initializeSectorChart();
            initializeCityChart();
            initializeSectorMap();
        }
        
        function convertDMSToDecimal(dmsString) {
            if (!dmsString || typeof dmsString !== 'string') return null;
            
            // Try to parse as decimal first
            if (dmsString.includes(',')) {
                const parts = dmsString.split(',');
                if (parts.length === 2) {
                    const lat = parseFloat(parts[0].trim());
                    const lng = parseFloat(parts[1].trim());
                    if (!isNaN(lat) && !isNaN(lng)) {
                        return [lat, lng];
                    }
                }
            }
            
            // DMS conversion regex patterns
            const dmsPattern = /([0-9]{1,3})[°]([0-9]{1,2})[']([0-9]{1,2}(?:\.[0-9]+)?)["\u201D]([NSEW])/gi;
            const matches = [...dmsString.matchAll(dmsPattern)];
            
            if (matches.length >= 2) {
                const coords = matches.map(match => {
                    const degrees = parseFloat(match[1]);
                    const minutes = parseFloat(match[2]);
                    const seconds = parseFloat(match[3]);
                    const direction = match[4].toUpperCase();
                    
                    let decimal = degrees + (minutes / 60) + (seconds / 3600);
                    
                    if (direction === 'S' || direction === 'W') {
                        decimal = -decimal;
                    }
                    
                    return decimal;
                });
                
                // Return lat, lng
                return coords.length >= 2 ? [coords[0], coords[1]] : null;
            }
            
            return null;
        }
        
        function initializeSectorMap() {
            const mapContainer = document.getElementById('sectorMap');
            if (!mapContainer) {
                console.error('Map container not found');
                return;
            }
            
            if (sectorMap) {
                sectorMap.remove();
            }
            
            sectorMap = L.map('sectorMap').setView([39.9208, 32.8541], 6);
            
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '© OpenStreetMap'
            }).addTo(sectorMap);
            
            const sectors = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Stats.Sectors));
            console.log('Sectors data:', sectors);
            console.log('Sectors length:', sectors ? sectors.length : 'null');
            
            if (sectors && sectors.length > 0) {
                let bounds = [];
                
                sectors.forEach((sector, index) => {
                    console.log(`Processing sector ${index}:`, sector);
                    
                    if (sector.Coordinates) {
                        console.log(`Sector ${sector.Code} coordinates:`, sector.Coordinates);
                        const coords = convertDMSToDecimal(sector.Coordinates);
                        console.log(`Converted coords for ${sector.Code}:`, coords);
                        
                        if (coords && coords.length === 2) {
                            const [lat, lng] = coords;
                            bounds.push([lat, lng]);
                            
                            let markerColor = '#6c757d';
                            if (sector.ExtricatedCount > 0) {
                                markerColor = '#dc3545';
                            } else if (sector.RescuedCount > 0) {
                                markerColor = '#198754';
                            } else if (sector.ExpectedVictimCount > 0) {
                                markerColor = '#0d6efd';
                            }
                            
                            console.log(`Adding marker for ${sector.Code} at [${lat}, ${lng}] with color ${markerColor}`);
                            
                            const marker = L.circleMarker([lat, lng], {
                                radius: 10,
                                fillColor: markerColor,
                                color: '#fff',
                                weight: 2,
                                opacity: 1,
                                fillOpacity: 0.8
                            }).addTo(sectorMap);
                            
                            const popupContent = `
                                <div class="p-2">
                                    <h6><strong>${sector.Code}</strong> - ${sector.Name}</h6>
                                    <p class="mb-1"><small>${sector.WorkAreaName}</small></p>
                                    <hr class="my-2">
                                    <div class="d-flex justify-content-between">
                                        <span>Beklenen:</span> <strong>${sector.ExpectedVictimCount}</strong>
                                    </div>
                                    <div class="d-flex justify-content-between">
                                        <span class="text-success">Sağ:</span> <strong>${sector.RescuedCount}</strong>
                                    </div>
                                    <div class="d-flex justify-content-between">
                                        <span class="text-danger">Ex:</span> <strong>${sector.ExtricatedCount}</strong>
                                    </div>
                                </div>
                            `;
                            
                            marker.bindPopup(popupContent);
                        } else {
                            console.warn('Invalid coordinates for sector:', sector.Code, sector.Coordinates);
                        }
                    } else {
                        console.warn('No coordinates for sector:', sector.Code);
                    }
                });
                
                console.log('Total bounds found:', bounds.length);
                
                if (bounds.length > 0) {
                    sectorMap.fitBounds(bounds, { padding: [20, 20] });
                    console.log('Map fitted to bounds');
                } else {
                    console.warn('No valid coordinates found, using default view');
                }
            } else {
                console.warn('No sectors data available');
            }
        }
        
        function initializeSectorChart() {
            const chartCanvas = document.getElementById('sectorChart');
            const rawData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SectorDistribution.Data));
            
            if (chartCanvas && rawData && rawData.length > 0) {
                chartData = {
                    labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SectorDistribution.Labels)),
                    data: rawData,
                    colors: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SectorDistribution.BackgroundColors))
                };
                createChart('sector', 'pie');
            }
        }
        
        function initializeCityChart() {
            const chartCanvas = document.getElementById('cityChart');
            const rawData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CityDistribution.Data));
            
            if (chartCanvas && rawData && rawData.length > 0) {
                cityChartData = {
                    labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CityDistribution.Labels)),
                    data: rawData,
                    colors: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CityDistribution.BackgroundColors))
                };
                createChart('city', 'bar'); // Default olarak bar chart
            }
        }
        
        function createChart(chartType, type) {
            const isCity = chartType === 'city';
            const chartCanvas = document.getElementById(isCity ? 'cityChart' : 'sectorChart');
            const data = isCity ? cityChartData : chartData;
            let chart = isCity ? currentCityChart : currentChart;
            
            if (!chartCanvas || !data) return;
            
            if (chart) {
                chart.destroy();
            }
            
            const ctx = chartCanvas.getContext('2d');
            let labels = data.labels;
            let dataValues = data.data;  // Renamed to avoid conflict
            let colors = data.colors;
            
            if (type === 'bar') {
                const combined = labels.map((label, i) => ({ label, data: dataValues[i], color: colors[i] }));
                combined.sort((a, b) => b.data - a.data);
                
                labels = combined.map(item => item.label);
                dataValues = combined.map(item => item.data);
                colors = combined.map(item => item.color);
            }
            
            const newChart = new Chart(ctx, {
                type: type,
                data: {
                    labels: labels,
                    datasets: [{
                        data: dataValues,
                        backgroundColor: colors,
                        borderColor: colors.map(color => color + '80'),
                        borderWidth: type === 'bar' ? 1 : 0
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { 
                            position: type === 'pie' ? 'bottom' : 'top',
                            display: type === 'pie'
                        }
                    },
                    scales: type === 'bar' ? {
                        y: {
                            beginAtZero: true,
                            ticks: { stepSize: 1 }
                        }
                    } : {}
                }
            });
            
            if (isCity) {
                currentCityChart = newChart;
            } else {
                currentChart = newChart;
            }
        }
        
        function switchChart(chartType, type) {
            const isCity = chartType === 'city';
            
            let pieBtn, barBtn;
            
            if (isCity) {
                pieBtn = document.getElementById('cityPieBtn');
                barBtn = document.getElementById('cityBarBtn');
            } else {
                pieBtn = document.getElementById('pieBtn');
                barBtn = document.getElementById('barBtn');
            }
            
            // Remove active class from both buttons
            if (pieBtn) pieBtn.classList.remove('active');
            if (barBtn) barBtn.classList.remove('active');
            
            // Add active class to the clicked button
            if (type === 'pie' && pieBtn) {
                pieBtn.classList.add('active');
            } else if (type === 'bar' && barBtn) {
                barBtn.classList.add('active');
            }
            
            createChart(chartType, type);
        }
        
        // Initialize chart on page load
        document.addEventListener('DOMContentLoaded', initializeCharts);
        
        // Start auto-refresh every 30 seconds
        refreshInterval = setInterval(refreshDashboard, 30000);
        
        // Cleanup on page unload
        window.addEventListener('beforeunload', () => {
            if (refreshInterval) {
                clearInterval(refreshInterval);
            }
        });
    </script>
}
