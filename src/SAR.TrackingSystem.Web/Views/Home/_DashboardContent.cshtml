@model SAR.TrackingSystem.Web.Models.DashboardViewModel

<div class="row g-3 mb-4">
    <div class="col">
        <a href="/volunteers?filter=inHub" class="text-decoration-none">
            <div class="card stat-card h-100 clickable-card">
                <div class="card-body text-center">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h3 class="text-success fw-bold mb-0">@Model.Stats.InHubCount</h3>
                            <p class="text-muted mb-0">BoO'da</p>
                        </div>
                        <i class="bi bi-house-check-fill text-success fs-2"></i>
                    </div>
                </div>
            </div>
        </a>
    </div>

    <div class="col">
        <a href="/volunteers?filter=inSector" class="text-decoration-none">
            <div class="card stat-card h-100 clickable-card">
                <div class="card-body text-center">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h3 class="text-warning fw-bold mb-0">@Model.Stats.InSectorCount</h3>
                            <p class="text-muted mb-0">Sektörde</p>
                        </div>
                        <i class="bi bi-geo-alt-fill text-warning fs-2"></i>
                    </div>
                </div>
            </div>
        </a>
    </div>

    <div class="col">
        <a href="/volunteers?filter=exited" class="text-decoration-none">
            <div class="card stat-card h-100 clickable-card">
                <div class="card-body text-center">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h3 class="text-info fw-bold mb-0">@Model.Stats.ExitCount</h3>
                            <p class="text-muted mb-0">Çıkış Yapan</p>
                        </div>
                        <i class="bi bi-door-open-fill text-info fs-2"></i>
                    </div>
                </div>
            </div>
        </a>
    </div>

    <div class="col">
        <a href="/volunteers?filter=notEntered" class="text-decoration-none">
            <div class="card stat-card h-100 clickable-card">
                <div class="card-body text-center">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h3 class="text-danger fw-bold mb-0">@Model.Stats.NonArrivedCount</h3>
                            <p class="text-muted mb-0">Katılmayan</p>
                        </div>
                        <i class="bi bi-person-x-fill text-danger fs-2"></i>
                    </div>
                </div>
            </div>
        </a>
    </div>

    <div class="col">
        <a href="/volunteers" class="text-decoration-none">
            <div class="card stat-card h-100 clickable-card">
                <div class="card-body text-center">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h3 class="text-primary fw-bold mb-0">@Model.Stats.TotalVolunteers</h3>
                            <p class="text-muted mb-0">Toplam Ekip Üyesi</p>
                        </div>
                        <i class="bi bi-people-fill text-primary fs-2"></i>
                    </div>
                </div>
            </div>
        </a>
    </div>
</div>

<!-- Ekip Dağılımı -->
<div class="row g-3 mb-4">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="bi bi-people-fill"></i>
                    Ekip Dağılımı (@Model.TotalTeamCount)
                </h5>
                <small class="text-muted">Operasyona katılan ekip üyelerinin takımlara göre dağılımı</small>
            </div>
            <div class="card-body p-0">
                <div class="team-distribution-container">
                    @if (Model.TeamDistribution.Teams.Any())
                    {
                        <div class="row g-2 p-3">
                            @foreach (var team in Model.TeamDistribution.Teams)
                            {
                                <div class="col-md-3 col-sm-6">
                                    <div class="card border-primary h-100">
                                        <div class="card-body p-3">
                                            <h6 class="card-title d-flex justify-content-between align-items-center">
                                                @team.Name
                                                <small class="badge bg-primary">@team.Percentage%</small>
                                            </h6>
                                            <div class="d-flex justify-content-between mb-2">
                                                <small class="text-muted">Gelen: <strong>@team.ArrivedCount</strong></small>
                                                <small class="text-muted">Toplam: <strong>@team.TotalCount</strong></small>
                                            </div>
                                            <div class="progress" style="height: 6px;">
                                                <div class="progress-bar" role="progressbar" style="width: @team.Percentage%"></div>
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(team.City) && team.City != "Belirtilmemiş")
                                            {
                                                <small class="text-muted mt-1 d-block">
                                                    <i class="bi bi-geo-alt"></i> @team.City
                                                </small>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-secondary m-3">
                            <i class="bi bi-info-circle"></i> Ekip verisi bulunamadı.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .team-distribution-container {
        height: 407px;
        overflow-y: auto;
        overflow-x: hidden;
        scrollbar-width: thin;
        scrollbar-color: var(--bs-primary) rgba(0,0,0,0.1);
    }

        /* Webkit browsers (Chrome, Safari) */
        .team-distribution-container::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }

        .team-distribution-container::-webkit-scrollbar-track {
            background: rgba(0,0,0,0.1);
            border-radius: 10px;
        }

        .team-distribution-container::-webkit-scrollbar-thumb {
            background-color: var(--bs-primary);
            border-radius: 10px;
        }
</style>

<!-- Sektör ve Şehir Dağılımı ve Hızlı İşlemler -->
<div class="row g-3 mb-4">
    <div class="col-md-4 d-flex">
        <div class="card w-100">
            <div class="card-header">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="bi bi-pie-chart"></i>
                        Sektör Dağılımı
                    </h5>
                    <div class="btn-group btn-group-sm" role="group">
                        <button type="button" class="btn btn-outline-primary active" id="pieBtn" onclick="switchChart('sector', 'pie')">
                            <i class="bi bi-pie-chart"></i>
                        </button>
                        <button type="button" class="btn btn-outline-primary" id="barBtn" onclick="switchChart('sector', 'bar')">
                            <i class="bi bi-bar-chart"></i>
                        </button>
                    </div>
                </div>
                <small class="text-muted d-block">Son hareket edilen sektörlere göre ekip üyesi sayıları</small>
            </div>
            <div class="card-body d-flex flex-column">
                @if (Model.SectorDistribution.Data.Any())
                {
                    <div class="flex-grow-1">
                        <canvas id="sectorChart" width="300" height="300"></canvas>
                    </div>
                }
                else
                {
                    <div class="alert alert-info flex-grow-1">
                        <i class="bi bi-info-circle"></i> Henüz sektör dağılımı yok.
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-md-4 d-flex">
        <div class="card w-100">
            <div class="card-header">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="bi bi-geo-alt"></i>
                        Şehir Dağılımı
                    </h5>
                    <div class="btn-group btn-group-sm" role="group">
                        <button type="button" class="btn btn-outline-info active" id="cityPieBtn" onclick="switchChart('city', 'pie')">
                            <i class="bi bi-pie-chart"></i>
                        </button>
                        <button type="button" class="btn btn-outline-info" id="cityBarBtn" onclick="switchChart('city', 'bar')">
                            <i class="bi bi-bar-chart"></i>
                        </button>
                    </div>
                </div>
                <small class="text-muted d-block">Operasyona katılan ekip üyelerinin şehirlere göre dağılımı</small>
            </div>
            <div class="card-body d-flex flex-column">
                @if (Model.CityDistribution.Data.Any())
                {
                    <div class="flex-grow-1">
                        <canvas id="cityChart" width="300" height="300"></canvas>
                    </div>
                }
                else
                {
                    <div class="alert alert-info flex-grow-1">
                        <i class="bi bi-info-circle"></i> Henüz şehir dağılımı yok.
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-md-4 d-flex">
        <div class="card w-100">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="bi bi-activity"></i>
                    Hızlı İşlemler
                </h5>
                <small class="text-muted">Sık kullanılan işlemler için kısayollar</small>
            </div>
            <div class="card-body d-flex flex-column">
                <div class="d-grid gap-2 flex-grow-1">
                    <a href="/volunteers/create" class="btn btn-primary">
                        <i class="bi bi-person-plus"></i>
                        Yeni Ekip Üyesi Ekle
                    </a>
                    <a href="/movements/quickentry" class="btn btn-warning">
                        <i class="bi bi-qr-code-scan"></i>
                        QR Giriş
                    </a>
                    <a href="/teams/create" class="btn btn-warning">
                        <i class="bi bi-people-fill"></i>
                        Yeni Ekip Ekle
                    </a>
                    <a href="/sectors/create" class="btn btn-info">
                        <i class="bi bi-building"></i>
                        Yeni Sektör Ekle
                    </a>
                    <a href="/movements" class="btn btn-success">
                        <i class="bi bi-arrow-left-right"></i>
                        Hareketler Listesi
                    </a>
                    <a href="/volunteers" class="btn btn-outline-primary">
                        <i class="bi bi-list"></i>
                        Ekip Üyesi Listesi
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Sistem Durumu -->
<div class="row g-3 mb-4">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="bi bi-info-circle"></i>
                    Sistem Durumu
                </h5>
            </div>
            <div class="card-body">
                <div class="alert alert-info">
                    <strong>Operasyon Aktif:</strong> Sistem çalışır durumda
                </div>

                @if (Model.RecentMovements.Any())
                {
                    <h6 class="mb-2">
                        <i class="bi bi-clock-history"></i> Son Hareketler
                    </h6>
                    <div class="table-responsive">
                        <table class="table table-sm table-striped">
                            <thead>
                                <tr>
                                    <th>Ekip Üyesi</th>
                                    <th>Hareket</th>
                                    <th>Zaman</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var movement in Model.RecentMovements.Take(5))
                                {
                                    <tr>
                                        <td>
                                            <div>
                                                <small><strong>@movement.VolunteerName</strong></small>
                                                <br>
                                                <small class="text-muted">@movement.TeamName | @movement.Role</small>
                                            </div>
                                        </td>
                                        <td>
                                            <small>
                                                <span class="text-muted">@movement.FromSectorDisplay</span>
                                                <i class="bi bi-arrow-right mx-1"></i>
                                                <span class="text-primary">@movement.ToSectorDisplay</span>
                                            </small>
                                        </td>
                                        <td><small class="text-muted">@movement.MovementTime.ToString("HH:mm")</small></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="text-center mt-2">
                        <a href="/movements" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-list"></i> Tüm Hareketler
                        </a>
                    </div>
                }
                else
                {
                    <div class="alert alert-secondary">
                        <i class="bi bi-info-circle"></i> Henüz hareket kaydı yok.
                    </div>
                }


            </div>
        </div>
    </div>
</div>
