@model SectorViewModel
@{
    ViewData["Title"] = "Sektör Sil";
}

<div class="row">
    <div class="col-md-8 offset-md-2">
        <div class="card">
            <div class="card-header bg-danger text-white">
                <h4><i class="bi bi-exclamation-triangle"></i> Sektör Sil</h4>
            </div>
            <div class="card-body">
                <div class="alert alert-warning">
                    <i class="bi bi-exclamation-triangle"></i>
                    <strong>Dikkat!</strong> Bu işlem geri alınamaz. Sektörü silmek istediğinizden emin misiniz?
                </div>

                <dl class="row">
                    <dt class="col-sm-3">Ad:</dt>
                    <dd class="col-sm-9">@Model.Name</dd>

                    <dt class="col-sm-3">Kod:</dt>
                    <dd class="col-sm-9"><code>@Model.Code</code></dd>
                </dl>

                <div class="d-flex justify-content-end gap-2">
                    <a href="/sectors" class="btn btn-secondary">
                        <i class="bi bi-arrow-left"></i> İptal
                    </a>
                    
                    <form method="post" asp-action="DeleteConfirmed" style="display: inline;">
                        <input type="hidden" asp-for="Id" />
                        <button type="submit" class="btn btn-danger" 
                                onclick="return confirm('Bu sektörü silmek istediğinizden emin misiniz?')">
                            <i class="bi bi-trash"></i> Sil
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
