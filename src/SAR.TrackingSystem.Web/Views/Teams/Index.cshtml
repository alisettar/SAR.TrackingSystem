@model List<TeamViewModel>
@{
    ViewData["Title"] = "Ekipler";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2><i class="bi bi-people-fill"></i> Ekipler</h2>
        <small class="text-muted">Takımları görüntüleyin, üye sayılarını takip edin</small>
    </div>
    <a href="/teams/create" class="btn btn-success">
        <i class="bi bi-plus"></i> Yeni Ekle
    </a>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Ad</th>
                        <th>Kod</th>
                        <th>Şehir</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var team in Model)
                    {
                        <tr>
                            <td>@team.Name</td>
                            <td>@team.Code</td>
                            <td>@(team.City ?? "-")</td>
                            <td>
                                <a href="/teams/details/@team.Id" class="btn btn-sm btn-primary">
                                    <i class="bi bi-eye"></i> Detay
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>