@model List<TeamViewModel>

<div class="container mt-4">
    <h2>Ekipler</h2>

    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="thead-dark">
                <tr>
                    <th>Ekip Adı</th>
                    <th>Şehir</th>
                    <th>Kod</th>
                    <th>İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var team in Model)
                {
                    <tr>
                        <td>@team.Name</td>
                        <td>@team.City</td>
                        <td>@team.Code</td>
                        <td>
                            <a asp-action="BooSectorTeamsDetails" asp-route-teamId="@team.Id" class="btn btn-info btn-sm">
                                Detayları Görüntüle
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>