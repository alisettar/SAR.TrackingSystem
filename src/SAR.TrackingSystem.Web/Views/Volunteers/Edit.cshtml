@model VolunteerUpdateViewModel
@{
    ViewData["Title"] = "Ekip Üyesi Düzenle";
}

<h2><i class="bi bi-pencil"></i> Ekip Üyesi Düzenle</h2>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<div class="card">
    <div class="card-body">
        <form method="post" onkeydown="if(event.key === 'Enter' && event.target.tagName !== 'TEXTAREA') { event.preventDefault(); this.submit(); }">
            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label">Ad Soyad</label>
                        <input asp-for="FullName" class="form-control" required />
                        <span asp-validation-for="FullName" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label">Ekip</label>
                        <select asp-for="TeamId" class="form-select" required>
                            @foreach (var team in (List<TeamViewModel>)ViewBag.Teams)
                            {
                                <option value="@team.Id">@team.Name</option>
                            }
                        </select>
                        <span asp-validation-for="TeamId" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label">Görev</label>
                        <input asp-for="Role" class="form-control" placeholder="Örn: Lider, Medik, Teknisyen" required />
                        <span asp-validation-for="Role" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label">QR ID</label>
                        <input asp-for="QRId" type="number" class="form-control" placeholder="QR kod okutarak otomatik doldurulabilir" 
                               pattern="[0-9]*" oninput="this.value = this.value.replace(/[^0-9]/g, '')" required />
                        <span asp-validation-for="QRId" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-save"></i> Güncelle
                </button>
                <a href="/volunteers" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> İptal
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
