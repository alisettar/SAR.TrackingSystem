@model PaginatedResponse<VolunteerViewModel>
@{
    ViewData["Title"] = "Ekip Üyeleri";
}

@section Styles {
<link rel="stylesheet" href="~/css/timeline.css" />
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2><i class="bi bi-people"></i> @ViewBag.FilterTitle</h2>
        <small class="text-muted">Ekip üyelerini yönetin, QR ID ve durum bilgilerini görüntüleyin</small>
        @if (!string.IsNullOrEmpty(ViewBag.Filter as string))
        {
            <div class="mt-2">
                <a href="/volunteers" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Tümünü Göster
                </a>
            </div>
        }
    </div>
    <div class="d-flex gap-2">
        <form method="get" class="d-flex">
            <input type="search" name="search" value="@ViewBag.SearchTerm" 
                   class="form-control me-2" placeholder="Ad, soyad, Görev veya QR ID ile ara..." 
                   style="min-width: 250px;">
            @if (!string.IsNullOrEmpty(ViewBag.Filter as string))
            {
                <input type="hidden" name="filter" value="@ViewBag.Filter" />
            }
            <button type="submit" class="btn btn-outline-secondary">
                <i class="bi bi-search"></i>
            </button>
            @if (!string.IsNullOrEmpty(ViewBag.SearchTerm as string))
            {
                <a href="/volunteers@(!string.IsNullOrEmpty(ViewBag.Filter as string) ? $"?filter={ViewBag.Filter}" : "")" class="btn btn-outline-danger ms-1">
                    <i class="bi bi-x"></i>
                </a>
            }
        </form>

        @if (@ViewBag.FilterTitle == "BoO'da Bulunan Ekip Üyeleri")
        {
            <a href="/volunteers/BooSectorTeams" class="btn btn-primary">
                <i class="bi bi-person-plus"></i> Boo'daki Takımlar
            </a>
        }

        @if (@ViewBag.FilterTitle == "Tüm Ekip Üyeleri")
        {
            <a href="/volunteers/BooSectorTeams" class="btn btn-primary">
                <i class="bi bi-person-plus"></i> Sektör'deki Takımlar
            </a>
        }

        <a href="/volunteers/create" class="btn btn-primary">
            <i class="bi bi-person-plus"></i> Yeni Ekip Üyesi
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible">
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible">
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        @TempData["Error"]
    </div>
}

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Ad Soyad</th>
                        <th>Ekip</th>
                        <th>Durum</th>
                        <th>QR ID</th>
                        <th>Görev</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var volunteer in Model.Items)
                    {
                        <tr>
                            <td><strong>@volunteer.FullName</strong></td>
                            <td><span class="badge bg-info">@volunteer.TeamName</span></td>
                            <td><span class="badge @volunteer.StateBadgeClass">@volunteer.StateDisplay</span></td>
                            <td>
                                @if (!string.IsNullOrEmpty(volunteer.QRId))
                                {
                                    <code>@volunteer.QRId</code>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(volunteer.Role))
                                {
                                    <span class="badge bg-secondary">@volunteer.Role</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td>
                                <div class="btn-group" role="group">
                                    <button type="button" class="btn btn-sm btn-outline-info" 
                                            onclick="showTimeline('@volunteer.Id', '@volunteer.FullName')"
                                            title="Hareket Geçmişi">
                                        <i class="bi bi-clock-history"></i>
                                    </button>
                                    <a href="/volunteers/edit/@volunteer.Id" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <button type="button" class="btn btn-sm btn-outline-danger" 
                                            onclick="deleteVolunteer('@volunteer.Id')">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            var searchParam = !string.IsNullOrEmpty(ViewBag.SearchTerm) ? $"&search={ViewBag.SearchTerm}" : "";
            var filterParam = !string.IsNullOrEmpty(ViewBag.Filter as string) ? $"&filter={ViewBag.Filter}" : "";
            var baseParams = searchParam + filterParam;
            <nav>
                <ul class="pagination justify-content-center">
                    @if (Model.Page > 1)
                    {
                        <li class="page-item">
                            <a class="page-link" href="?page=1@baseParams">İlk</a>
                        </li>
                        <li class="page-item">
                            <a class="page-link" href="?page=@(Model.Page - 1)@baseParams">‹</a>
                        </li>
                    }
                    
                    @{
                        var startPage = Math.Max(1, Model.Page - 2);
                        var endPage = Math.Min(Model.TotalPages, Model.Page + 2);
                    }
                    
                    @for (int i = startPage; i <= endPage; i++)
                    {
                        <li class="page-item @(i == Model.Page ? "active" : "")">
                            <a class="page-link" href="?page=@i@baseParams">@i</a>
                        </li>
                    }
                    
                    @if (Model.Page < Model.TotalPages)
                    {
                        <li class="page-item">
                            <a class="page-link" href="?page=@(Model.Page + 1)@baseParams">›</a>
                        </li>
                        <li class="page-item">
                            <a class="page-link" href="?page=@Model.TotalPages@baseParams">Son (@Model.TotalPages)</a>
                        </li>
                    }
                </ul>
                
                <div class="text-center mt-2">
                    <small class="text-muted">
                        Sayfa @Model.Page / @Model.TotalPages - 
                        Toplam @Model.TotalCount ekip üyesi
                    </small>
                </div>
            </nav>
        }
    </div>
</div>

@* Include Timeline Modal *@
@{await Html.RenderPartialAsync("_TimelineModal");}

@section Scripts {
    <script src="~/js/timeline.js"></script>
}
