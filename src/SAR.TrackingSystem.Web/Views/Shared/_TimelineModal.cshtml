<!-- Timeline Modal - Partial View -->
<div class="offcanvas offcanvas-end" tabindex="-1" id="timelineOffcanvas" aria-labelledby="timelineOffcanvasLabel">
    <div class="offcanvas-header">
        <h5 class="offcanvas-title" id="timelineOffcanvasLabel">
            <i class="bi bi-clock-history me-2"></i>
            <span id="timelineName">Hareket Geçmişi</span>
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Kapat"></button>
    </div>
    <div class="offcanvas-body" id="timelineContent">
        <div class="d-flex justify-content-center p-4">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Yüklüyor...</span>
            </div>
        </div>
    </div>
</div>
