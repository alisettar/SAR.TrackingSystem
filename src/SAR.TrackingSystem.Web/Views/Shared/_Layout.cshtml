<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SAR Takip Sistemi</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet">

    <style>
        :root {
            --sar-primary: #1e3a8a;
            --sar-secondary: #64748b;
            --sar-accent: #f97316;
            --sar-success: #16a34a;
            --sar-warning: #eab308;
            --sar-danger: #dc2626;
        }

        /* Dark theme overrides */
        [data-theme="dark"] {
            --sar-primary: #2d3748;
            --sar-secondary: #4a5568;
            --sar-accent: #e2e8f0;
            --sar-success: #68d391;
            --sar-warning: #f6e05e;
            --sar-danger: #fc8181;
        }

        [data-theme="dark"] body {
            background-color: #1a202c;
            color: #e2e8f0;
        }

        [data-theme="dark"] .card {
            background-color: #2d3748;
            border-color: #4a5568;
            color: #e2e8f0;
        }

        [data-theme="dark"] .table {
            color: #e2e8f0;
            --bs-table-bg: #2d3748;
        }

        [data-theme="dark"] .table-dark {
            --bs-table-bg: #4a5568;
            --bs-table-striped-bg: #2d3748;
            color: #ffffff;
        }

        [data-theme="dark"] .table-dark th {
            background-color: #4a5568 !important;
            color: #ffffff !important;
        }

        [data-theme="dark"] .table tbody {
            background-color: #2d3748;
        }

        [data-theme="dark"] .table tbody td {
            color: #e2e8f0 !important;
        }

        [data-theme="dark"] .table-hover tbody tr:hover {
            background-color: #4a5568 !important;
        }

        [data-theme="dark"] .table > :not(caption) > * > * {
            border-bottom-color: #4a5568;
        }

        [data-theme="dark"] .alert {
            background-color: #2d3748;
            border-color: #4a5568;
            color: #e2e8f0;
        }

        [data-theme="dark"] .form-control {
            background-color: #2d3748;
            border-color: #4a5568;
            color: #e2e8f0;
        }

        [data-theme="dark"] .form-control:focus {
            background-color: #2d3748;
            border-color: #e2e8f0;
            color: #e2e8f0;
            box-shadow: 0 0 0 0.25rem rgba(226, 232, 240, 0.25);
        }
        
        /* Dropdown and Select Elements */
        [data-theme="dark"] .form-select {
            background-color: #2d3748;
            border-color: #4a5568;
            color: #e2e8f0;
        }
        
        [data-theme="dark"] .form-select:focus {
            background-color: #2d3748;
            border-color: #e2e8f0;
            color: #e2e8f0;
            box-shadow: 0 0 0 0.25rem rgba(226, 232, 240, 0.25);
        }
        
        [data-theme="dark"] .form-select option {
            background-color: #2d3748;
            color: #e2e8f0;
        }
        
        /* Navbar and Navigation */
        [data-theme="dark"] .navbar-dark {
            background-color: #2d3748;
        }
        
        [data-theme="dark"] .nav-tabs .nav-link {
            background-color: #2d3748;
            border-color: #4a5568;
            color: #e2e8f0;
        }
        
        [data-theme="dark"] .nav-tabs .nav-link.active {
            background-color: #4a5568;
            border-color: #4a5568;
            color: #ffffff;
        }
        
        [data-theme="dark"] .nav-tabs .nav-link:hover {
            background-color: #4a5568;
            border-color: #4a5568;
        }

        /* Buttons & Badges */
        [data-theme="dark"] .btn-primary {
            background-color: #4a5568;
            border-color: #4a5568;
            color: #ffffff;
        }

        [data-theme="dark"] .btn-primary:hover {
            background-color: #2d3748;
            border-color: #2d3748;
        }

        [data-theme="dark"] .btn-outline-primary {
            color: #e2e8f0;
            border-color: #4a5568;
        }

        [data-theme="dark"] .btn-outline-primary:hover {
            background-color: #4a5568;
            border-color: #4a5568;
            color: #ffffff;
        }

        [data-theme="dark"] .btn-secondary {
            background-color: #4a5568;
            border-color: #4a5568;
        }

        [data-theme="dark"] .btn-outline-secondary {
            color: #e2e8f0;
            border-color: #4a5568;
        }

        [data-theme="dark"] .badge {
            color: #ffffff;
        }

        /* Pagination */
        [data-theme="dark"] .pagination .page-link {
            background-color: #2d3748;
            border-color: #4a5568;
            color: #e2e8f0;
        }

        [data-theme="dark"] .pagination .page-link:hover {
            background-color: #4a5568;
            border-color: #4a5568;
            color: #ffffff;
        }

        [data-theme="dark"] .pagination .page-item.active .page-link {
            background-color: #4a5568;
            border-color: #4a5568;
            color: #ffffff;
        }

        /* Search & Form inputs */
        [data-theme="dark"] .form-control::placeholder {
            color: #a0aec0;
        }

        /* Text colors for both themes */
        .text-muted {
            color: #9ca3af !important;
        }
        
        [data-theme="dark"] .text-muted {
            color: #a0aec0 !important;
        }

        [data-theme="dark"] .stat-card h3 {
            color: #ffffff !important;
        }

        /* Badges - better contrast */
        [data-theme="dark"] .badge.bg-secondary {
            background-color: #718096 !important;
            color: #ffffff !important;
        }

        [data-theme="dark"] .badge.bg-warning {
            background-color: #d69e2e !important;
            color: #1a202c !important;
        }

        [data-theme="dark"] .text-muted {
            color: #a0aec0 !important;
        }

        /* Dashboard table headers */
        [data-theme="dark"] .table thead th {
            color: #e2e8f0 !important;
        }

        [data-theme="dark"] .table-sm th {
            color: #e2e8f0 !important;
        }

        .navbar-brand {
            font-weight: 700;
            color: white !important;
        }

        .navbar {
            background: linear-gradient(135deg, var(--sar-primary) 0%, #1e40af 100%) !important;
            border-bottom: 3px solid var(--sar-accent);
        }

        .nav-link {
            color: rgba(255,255,255,0.9) !important;
            font-weight: 500;
        }

            .nav-link:hover {
                color: var(--sar-accent) !important;
            }

        .btn-primary {
            background-color: var(--sar-primary);
            border-color: var(--sar-primary);
        }

            .btn-primary:hover {
                background-color: #1e40af;
                border-color: #1e40af;
            }

        .card-header {
            background: linear-gradient(90deg, var(--sar-primary) 0%, #3b82f6 100%);
            color: white;
            font-weight: 600;
        }

        .stat-card {
            border-left: 4px solid var(--sar-accent);
            transition: transform 0.2s;
        }

            .stat-card:hover {
                transform: translateY(-2px);
            }

        .table-hover tbody tr:hover {
            background-color: rgba(30, 58, 138, 0.05);
        }

        .alert-info {
            background-color: rgba(30, 58, 138, 0.1);
            border-color: var(--sar-primary);
            color: var(--sar-primary);
        }

        footer {
            background-color: var(--sar-primary) !important;
            color: white;
        }
        
        /* Navbar alignment fix */
        .navbar-nav .nav-item {
            display: flex;
            align-items: center;
        }
        
        #themeToggle {
            height: 38px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0;
        }
        
        .navbar-nav .nav-link {
            height: 38px;
            display: flex;
            align-items: center;
            margin: 0;
            padding: 0.5rem 1rem;
        }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">
    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container">
            <a class="navbar-brand" href="/">
                <i class="bi bi-shield-check me-2"></i>SAR Takip Sistemi
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/">
                            <i class="bi bi-house me-1"></i>Gösterge Paneli
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/volunteers">
                            <i class="bi bi-people me-1"></i>Ekip Üyeleri
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/movements">
                            <i class="bi bi-arrow-left-right me-1"></i>Hareketler
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-warning" href="/movements/quickentry">
                            <i class="bi bi-qr-code-scan me-1"></i>QR İşlemler
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/sectors">
                            <i class="bi bi-building me-1"></i>Sektörler
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/teams">
                            <i class="bi bi-people-fill me-1"></i>Ekipler
                        </a>
                    </li>
                </ul>

                <ul class="navbar-nav">
                    <li class="nav-item me-2">
                        <button id="themeToggle" class="btn btn-outline-light btn-sm" title="Tema Değiştir">
                            <i class="bi bi-moon" id="themeIcon"></i>
                        </button>
                    </li>
                    <li class="nav-item">
                        <span class="nav-link">
                            <i class="bi bi-clock me-1"></i>@DateTime.Now.ToString("HH:mm")
                        </span>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <main class="container my-4 flex-grow-1">
        @RenderBody()
    </main>

    <footer class="py-3 mt-auto">
        <div class="container text-center">
            <small>&copy; @DateTime.Now.Year SAR Tracking System - Arama Kurtarma Ekip Takip Sistemi - Versiyon: @SystemVersion.FullVersion</small>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    
    <script>
        // Theme Toggle Functionality
        const themeToggle = document.getElementById('themeToggle');
        const themeIcon = document.getElementById('themeIcon');
        const html = document.documentElement;
        
        // Check saved theme or default to dark
        const currentTheme = sessionStorage.getItem('theme') || 'dark';
        html.setAttribute('data-theme', currentTheme);
        updateThemeIcon(currentTheme);
        
        themeToggle.addEventListener('click', () => {
            const currentTheme = html.getAttribute('data-theme');
            const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
            
            html.setAttribute('data-theme', newTheme);
            sessionStorage.setItem('theme', newTheme);
            updateThemeIcon(newTheme);
        });
        
        function updateThemeIcon(theme) {
            themeIcon.className = theme === 'dark' ? 'bi bi-sun' : 'bi bi-moon';
        }
    </script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>