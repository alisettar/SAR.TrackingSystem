@model PaginatedResponse<MovementViewModel>
@{
    ViewData["Title"] = "Hareketler";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2><i class="bi bi-arrow-left-right"></i> Hareketler</h2>
        <small class="text-muted">Ekip üyesi hareketlerini görüntüleyin ve yönetin</small>
    </div>
    <div class="d-flex gap-2">
        <form method="get" class="d-flex">
            <input type="search" name="search" value="@ViewBag.SearchTerm" 
                   class="form-control me-2" placeholder="Gönüllü adı, ekip veya sektör ara..." 
                   style="min-width: 250px;">
            <button type="submit" class="btn btn-outline-secondary">
                <i class="bi bi-search"></i>
            </button>
            @if (!string.IsNullOrEmpty(ViewBag.SearchTerm as string))
            {
                <a href="/movements" class="btn btn-outline-danger ms-1">
                    <i class="bi bi-x"></i>
                </a>
            }
        </form>
        @if (Context.Request.Query.ContainsKey("admin") && Context.Request.Query["admin"] == "true")
        {
            <a href="/movements/create" class="btn btn-success">
                <i class="bi bi-plus-circle"></i> Ekip Hareket Kaydı
            </a>
        }
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible">
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        @TempData["Success"]
    </div>
}

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Ekip Üyesi</th>
                        <th>Kaynak</th>
                        <th>Hedef</th>
                        <th>Zaman</th>
                        <th>Grup</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var movement in Model.Items)
                    {
                        <tr>
                            <td>
                                <div>
                                    <strong>@movement.VolunteerName</strong>
                                    <br>
                                    <small class="text-muted">
                                        <i class="bi bi-people"></i> @movement.TeamName |
                                        <i class="bi bi-person-badge"></i> @movement.Role
                                    </small>
                                </div>
                            </td>
                            <td>
                                <span class="badge bg-secondary">@movement.FromSectorDisplay</span>
                            </td>
                            <td><span class="badge bg-primary">@movement.ToSectorDisplay</span></td>
                            <td>@movement.MovementTime.ToString("dd.MM HH:mm")</td>
                            <td>
                                @if (movement.IsGroupMovement)
                                {
                                    <span class="badge bg-warning text-dark">
                                        <i class="bi bi-people"></i> Grup
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">Tekil</span>
                                }
                            </td>
                            <td>
                                <form method="post" action="/movements/delete/@movement.Id" class="d-inline" 
                                      onsubmit="return confirm('Bu hareketi silmek istediğinizden emin misiniz?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Hareketi Sil">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav>
                <ul class="pagination justify-content-center">
                    @* İlk sayfa *@
                    @if (Model.Page > 1)
                    {
                        <li class="page-item">
                            <a class="page-link" href="?page=1@(!string.IsNullOrEmpty(ViewBag.SearchTerm) ? $"&search={ViewBag.SearchTerm}" : "")">İlk</a>
                        </li>
                    }
                    
                    @* Önceki sayfa *@
                    @if (Model.Page > 1)
                    {
                        <li class="page-item">
                            <a class="page-link" href="?page=@(Model.Page - 1)@(!string.IsNullOrEmpty(ViewBag.SearchTerm) ? $"&search={ViewBag.SearchTerm}" : "")">‹</a>
                        </li>
                    }
                    
                    @* Sayfa numaraları (mevcut sayfanın çevresinde 5 sayfa) *@
                    @{
                        var startPage = Math.Max(1, Model.Page - 2);
                        var endPage = Math.Min(Model.TotalPages, Model.Page + 2);
                    }
                    
                    @for (int i = startPage; i <= endPage; i++)
                    {
                        <li class="page-item @(i == Model.Page ? "active" : "")">
                            <a class="page-link" href="?page=@i@(!string.IsNullOrEmpty(ViewBag.SearchTerm) ? $"&search={ViewBag.SearchTerm}" : "")">@i</a>
                        </li>
                    }
                    
                    @* Sonraki sayfa *@
                    @if (Model.Page < Model.TotalPages)
                    {
                        <li class="page-item">
                            <a class="page-link" href="?page=@(Model.Page + 1)@(!string.IsNullOrEmpty(ViewBag.SearchTerm) ? $"&search={ViewBag.SearchTerm}" : "")">›</a>
                        </li>
                    }
                    
                    @* Son sayfa *@
                    @if (Model.Page < Model.TotalPages)
                    {
                        <li class="page-item">
                            <a class="page-link" href="?page=@Model.TotalPages@(!string.IsNullOrEmpty(ViewBag.SearchTerm) ? $"&search={ViewBag.SearchTerm}" : "")">Son (@Model.TotalPages)</a>
                        </li>
                    }
                </ul>
                
                <div class="text-center mt-2">
                    <small class="text-muted">
                        Sayfa @Model.Page / @Model.TotalPages - 
                        Toplam @Model.TotalCount hareket
                    </small>
                </div>
            </nav>
        }
    </div>
</div>
